<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="700" prefWidth="580" spacing="20" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ni.edu.uam.practicahilosjavafx.ProcesadorController">

    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>

    <Label style="-fx-font-size: 22px;" text="Procesador de registros" />

    <Label fx:id="lblEstado" text="Esperando inicio" />

    <ProgressBar fx:id="barraProgreso" prefWidth="420" progress="0" />

    <Label fx:id="lblPorcentaje" text="0%" />


    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnIniciar" onAction="#iniciarProceso" text="Iniciar" />

        <Button fx:id="btnDetener" disable="true" onAction="#detenerProceso" text="Detener" />

        <Button fx:id="btnReiniciar" onAction="#reiniciarProceso" text="Reiniciar" />

        <Button fx:id="btnBloquear" onAction="#procesoBloqueante" text="Bloquear" />
    </HBox>

    <VBox spacing="10">
        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <Label style="-fx-font-size: 22px;" text="Clientes" />

        <Label fx:id="lblEstadoClientes" text="Esperando inicio" />

        <ProgressBar fx:id="barraProgresoClientes" prefWidth="420" progress="0" />

        <Label fx:id="lblPorcentajeClientes" text="0%" />
        <HBox>
            <Button fx:id="btnDetenerClientes" disable="true" onAction="#detenerProceso" text="Detener" />

            <Button fx:id="btnReiniciarClientes" onAction="#reiniciarProceso" text="Reiniciar" />

            <Button fx:id="btnBloquearClientes" onAction="#procesoBloqueante" text="Bloquear" />
        </HBox>

        <Label style="-fx-font-size: 22px;" text="Productos" />

        <Label fx:id="lblEstadoProductos" text="Esperando inicio" />

        <ProgressBar fx:id="barraProgresoProductos" prefWidth="420" progress="0" />

        <Label fx:id="lblPorcentajeProductos" text="0%" />
        <HBox>
            <Button fx:id="btnDetenerProductos" disable="true" onAction="#detenerProceso" text="Detener" />

            <Button fx:id="btnReiniciarProductos" onAction="#reiniciarProceso" text="Reiniciar" />

            <Button fx:id="btnBloquearProductos" onAction="#procesoBloqueante" text="Bloquear" />
        </HBox>

        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <HBox>
            <Button fx:id="btnIniciarBoth" onAction="#iniciarProceso" text="Iniciar" />

        </HBox>



    </VBox>



</VBox>
